# Local environment (git identity, secrets)
.devcontainer/.env
.env
.env.local
.env.*.local

# Generated log snapshots (make collect-logs)
logs/
support-bundles/


# Local Yugabyte client installs (use brew or the devcontainer instead)
yugabyte-client-*/
yugabyte-client-*.tar.gz

# Editor settings (user-specific)
.vscode/
.idea/

# Local agent notes (not for the repo)
CLAUDE.md

# Screen recordings (never commit; they are huge)
*.mov
*.mp4

# Video script/recording guide (local prep, not for the repo)
video/

# macOS
.DS_Store

# Codespace post-start progress (live during bootstrap)
bootstrap.log
bootstrap-status.txt

# YugabyteDB cluster data (Codespaces bind mounts; captured in prebuild snapshots)
.yb-data/

# Python
.venv/
__pycache__/
*.pyc

# Session handoff scratch (local only)
HANDOFF.md
